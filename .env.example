# ARAB code — متغيرات البيئة المطلوبة
# ---------------------------------------------------------------------------
# هذا الملف يحتوي أسماء المتغيرات فقط مع قيم توضيحية غير صالحة للإنتاج.
# لا تضع أي سر حقيقي هنا ولا ترفع ملف .env إلى المستودع (مستثنى في .gitignore).
# في الإنتاج اضبط هذه القيم في إعدادات المنصة (Vercel → Project → Settings →
# Environment Variables) أو في Secret Manager، وليس في ملف داخل المستودع.
# ---------------------------------------------------------------------------

# ===== الجلسات (إلزامي) =====
# سلسلة عشوائية طويلة (32 حرفاً على الأقل). مثال للتوليد:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# تغيير هذه القيمة يُبطل كل الجلسات الحالية (وهذا مطلوب بعد أي حادث أمني).
JWT_SECRET=REPLACE_WITH_64_HEX_CHARS_MINIMUM_32

# ===== الهوية (إلزامي) =====
# بريد حساب الإدارة الوحيد. الصلاحيات الإدارية تُشتق منه في الخادم فقط.
ADMIN_EMAIL=admin@example.invalid

# ===== النطاق العام (إلزامي في الإنتاج) =====
# يُستخدم لبناء روابط التفعيل وإعادة التعيين وredirect_uri لجوجل.
# لا يُشتق من ترويسة Host في الإنتاج.
PUBLIC_BASE_URL=https://www.example.invalid

# نطاق مستقل لتقديم محتوى المستخدمين القابل للتنفيذ (HTML/JS/SVG).
# يجب أن يختلف عن PUBLIC_BASE_URL ولا يشارك ملفات ارتباط المنصة.
# اتركه فارغاً حتى تجهيز النطاق — عندها يُقدَّم المحتوى كنص آمن فقط.
UNTRUSTED_CONTENT_ORIGIN=

# ===== مخزن البيانات الحالي: GitHub Contents API (مرحلة انتقالية) =====
# توكن بأقل صلاحية ممكنة (contents: read/write على هذا المستودع فقط).
GITHUB_TOKEN=REPLACE_WITH_GITHUB_TOKEN
GITHUB_REPO=owner/repo
GITHUB_BRANCH=main

# ===== البريد (SMTP) =====
SMTP_HOST=smtp.example.invalid
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@example.invalid
SMTP_PASS=REPLACE_WITH_SMTP_PASSWORD

# ===== Cloudflare Turnstile (إلزامي في الإنتاج) =====
# غياب هذا المفتاح في الإنتاج يوقف الخدمة (503) ولا يتجاوز التحقق بصمت.
TURNSTILE_SECRET_KEY=REPLACE_WITH_TURNSTILE_SECRET

# ===== Google OAuth (اختياري — لتسجيل الدخول بجوجل) =====
# إذا تُركت فارغة يُعطَّل مسار جوجل بأمان بدل العمل بإعداد ناقص.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ===== خدمة رفع الملفات الخارجية =====
# لا توجد قيمة افتراضية في الشيفرة: بغياب المفتاح تُرفض مسارات الرفع (503).
# الاسم القديم NEZUKO_API_KEY لا يزال مقبولاً خلال الانتقال.
UPLOADS_API_KEY=
UPLOADS_API_URL=https://uploads.example.invalid/api/upload
UPLOADS_PUBLIC_ORIGIN=https://uploads.example.invalid
UPLOADS_TIMEOUT_MS=15000

# ===== قاعدة البيانات (هدف الترحيل — غير مطلوبة قبل التحويل) =====
# PostgreSQL مُدارة. راجع migrations/ و scripts/import-json-to-pg.js
DATABASE_URL=

# ===== حدود تشغيلية (اختيارية، قيم غير سرية) =====
MAX_JSON_BODY_BYTES=262144
MAX_CODE_CHARS=200000
MAX_AVATAR_BYTES=3145728
MAX_ARCHIVE_BYTES=4194304
