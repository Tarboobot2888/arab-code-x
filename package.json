{
  "name": "arab-code-web",
  "version": "2.1.0",
  "private": true,
  "type": "commonjs",
  "description": "ARAB code — منصة نشر الأكواد العربية",
  "engines": {
    "node": ">=22.0.0 <23"
  },
  "packageManager": "npm@10.9.4",
  "scripts": {
    "test": "node --test \"tests/**/*.test.js\"",
    "test:watch": "node --test --watch \"tests/**/*.test.js\"",
    "lint": "node scripts/lint.js",
    "check": "npm run lint && npm run test",
    "verify:data": "node scripts/verify-data.js",
    "audit:deps": "npm audit --omit=dev",
    "secrets:scan": "node scripts/scan-secrets.js",
    "backup:data": "node scripts/backup-data.js",
    "revoke:tokens": "node scripts/revoke-legacy-tokens.js",
    "db:migrate": "node scripts/migrate.js",
    "db:import": "node scripts/import-json-to-pg.js",
    "db:reconcile": "node scripts/reconcile.js"
  },
  "dependencies": {
    "bcryptjs": "2.4.3",
    "jsonwebtoken": "9.0.3",
    "nodemailer": "10.1.2"
  },
  "optionalDependencies": {
    "pg": "8.13.1"
  }
}
