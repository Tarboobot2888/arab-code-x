{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/zip",
      "destination": "/zips"
    },
    {
      "source": "/zip/new",
      "destination": "/zip-new"
    },
    {
      "source": "/zip/:slug",
      "destination": "/zip-item"
    },
    {
      "source": "/u/:username",
      "destination": "/user"
    },
    {
      "source": "/c/:filename",
      "destination": "/code"
    }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "api/**/*.js"
    }
  },
  "headers": [
    {
      "source": "/(.*)\\.(js|css|svg|png|jpg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "arab-code.cv"
        }
      ],
      "destination": "https://www.arab-code.cv/:path*",
      "permanent": true
    }
  ]
}
